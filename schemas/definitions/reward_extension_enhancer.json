{
  "$id": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/definitions/reward_extension_enhancer.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "enum": [
        "enhancer"
      ]
    },
    "extensions": {
      "type": "array",
      "description": "Extensions for enhancer rewards.",
      "items": {
        "properties": {
          "enhancer": {
            "type": "object",
            "description": "Enhancer reward specific properties.",
            "properties": {
              "enhancer": {
                "$ref": "../definitions/enhancers.json",
                "description": "Reference to the Enhancer to offer."
              },
              "additional_upgrade_options": {
                "type": "array",
                "items": {
                  "$ref": "../definitions/card_upgrade.json"
                },
                "description": "Additonal upgrade options."
              },
              "cache_selected_card": {
                "type": "boolean",
                "description": "Cache the card selected for future events."
              },
              "use_cache_card": {
                "type": "boolean",
                "description": "Use the previously cached card."
              }
            }
          }
        }
      }
    }
  }
}