{
  "$id": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/definitions/reward_extension_health.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "enum": [
        "health"
      ]
    },
    "extensions": {
      "type": "array",
      "description": "Extensions for health rewards.",
      "items": {
        "properties": {
          "health": {
            "type": "object",
            "description": "Health reward specific properties.",
            "properties": {
              "amount": {
                "type": "integer",
                "description": "How much health to give."
              }
            }
          }
        }
      }
    }
  }
}