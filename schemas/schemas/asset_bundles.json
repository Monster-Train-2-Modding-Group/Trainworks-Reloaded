{
  "$id": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/schemas/asset_bundles.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "asset_bundles": {
      "type": "array",
      "items": {
        "required": [
          "id",
          "paths"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string",
            "description": "ID for the asset bundle."
          },
          "paths": {
            "type": "object",
            "required": ["windows, macosx, linux"],
            "properties": {
              "windows": {
                "type": "string",
                "description": "Relative path to platform specific AssetBundle build."
              },
              "macosx": {
                "type": "string",
                "description": "Relative path to platform specific AssetBundle build."
              },
              "linux": {
                "type": "string",
                "description": "Relative path to platform specific AssetBundle build."
              }
            },
            "description": "The path to the asset bundle."
          }
        }
      }
    }
  }
}